{
  "name": "boltstore",
  "version": "1.0.1",
  "private": false,
  "description": "Boltstore server — managed SQLite databases with HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "boltstore": "./dist/bin.js"
  },
  "files": ["dist", "admin/dist"],
  "scripts": {
    "bolt": "bun src/bin.ts",
    "boltstore": "bun src/bin.ts",
    "dev": "bun --watch src/bin.ts serve",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "compile": "bun build --compile --target=bun-linux-x64 --outfile=dist/boltstore ./src/entry.ts",
    "compile:macos": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/boltstore ./src/entry.ts",
    "compile:windows": "bun build --compile --target=bun-windows-x64 --outfile=dist/boltstore.exe ./src/entry.ts",
    "prepublish": "cd admin && bun install && bun run build && cd .. && bun run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boltstore/boltstore"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
