{
  "name": "boltstore",
  "version": "1.0.0",
  "private": false,
  "description": "Boltstore server — lightweight backend with realtime sync",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "boltstore": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "compile": "bun build --compile --target=bun-linux-x64 --outfile=dist/boltstore ./src/entry.ts",
    "compile:macos": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/boltstore ./src/entry.ts",
    "compile:windows": "bun build --compile --target=bun-windows-x64 --outfile=dist/boltstore.exe ./src/entry.ts",
    "prepublish": "bun run build"
  },
  "dependencies": {
    "@boltstore/utils": "^1.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}